FROM docker.io/mediawiki:1.43-fpm

RUN apt-get update && apt-get install -y \
    nginx supervisor \
    libzip-dev zip

# install wikidiff2 (https://phabricator.wikimedia.org/T196132) and zip
ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN install-php-extensions zip wikidiff2

COPY --from=docker.io/composer/composer:2-bin /composer /usr/bin/composer

##########################
### EXTENSIONS & SKINS ###
##########################

COPY resources/composer.local.json /var/www/html/composer.local.json

RUN for ext in Description2 Widgets PluggableAuth WSOAuth Realnames UserMerge Popups ExternalData; do \
    git clone -b REL1_43 --depth 1 https://gerrit.wikimedia.org/r/mediawiki/extensions/$ext /var/www/html/extensions/$ext; \
    done

RUN git clone --depth 1 https://github.com/Kneemund/mediawiki-discord-oauth /var/www/html/extensions/DiscordOAuth && \
    git clone --depth 1 https://github.com/Kneemund/mw-discord /var/www/html/extensions/Discord && \
    git clone --depth 1 -b v3.24.0 https://github.com/StarCitizenTools/mediawiki-skins-Citizen.git /var/www/html/skins/Citizen

RUN composer install --no-dev

#####################
### CONFIGURATION ###
#####################

# setup compiled_templates for Widgets extension
RUN chown -R www-data:www-data /var/www/html/extensions/Widgets/compiled_templates

###########################
### NGINX & SUPERVISORD ###
###########################

RUN rm /etc/nginx/sites-enabled/default

COPY resources/nginx/wiki.conf /etc/nginx/sites-enabled/wiki.conf
COPY resources/robots.txt /var/www/html/robots.txt

COPY resources/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

CMD ["/usr/bin/supervisord"]
